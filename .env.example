# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne publiez JAMAIS le fichier .env.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# URL publique du site (sans "/" final) : sert au SEO (canonical, sitemap, Open Graph)
SITE_URL=https://www.exemple-etimarki.org

# Premier administrateur, créé au premier démarrage si aucun compte n'existe.
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est affiché UNE fois dans la console.
ADMIN_EMAIL=pamojahakunamatatardc@gmail.com
ADMIN_PASSWORD=

# Sécurité / sessions
SESSION_HOURS=12
# Mettre 1 si le site est derrière un proxy (Nginx, Caddy, Render, Railway...) pour lire la vraie IP
TRUST_PROXY=1

# Limites d'envoi (en Mo)
MAX_IMAGE_MB=8
MAX_VIDEO_MB=60

# Langues activées (ordre = priorité). Le français est la langue principale. Ex : fr,en,sw
LANGS=fr

# Stockage (par défaut : ./storage). Sur un hébergeur, pointez vers un disque persistant.
DATA_DIR=./storage

# Optionnel : identifiant de chaîne YouTube (UC...) pour afficher les dernières vidéos
YOUTUBE_CHANNEL_ID=
# Optionnel : URL de webhook appelée à chaque nouveau message de contact (Make, Zapier, n8n...)
CONTACT_WEBHOOK_URL=
